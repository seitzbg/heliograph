# Environment for `docker compose up`. Copy this file to `.env` and fill in
# real values:
#
#   cp .env.example .env
#
# Two groups of settings live here:
#   - Collector settings (the `SMOKED_*` block below) are read by the DEFAULT
#     `docker compose up` — the admin API password/key/TTL and the graph
#     absolute-time default all take effect without any profile.
#   - Everything else configures the bundled Caddy reverse proxy and is only
#     read under the `federation` profile (`docker compose --profile federation up`);
#     the default `up` ignores those (federation stays dark).

# Public hostname browsers reach the dashboard at, via Caddy. Caddy obtains a Let's
# Encrypt certificate for it automatically. Its DNS A/AAAA record must point at this
# host. With the default HTTP-01 challenge, port 80 must be reachable from the
# internet during issuance/renewal; with DNS-01 (see below) it need not be.
# Tip: set DOMAIN=localhost to smoke-test the proxy with a self-signed cert
# (Caddy skips ACME for localhost). Agents don't use this — see SMOKED_AGENT_HOSTNAME
# below, which is typically set to the same value.
DOMAIN=smoke.example.com

# Contact address for the ACME (Let's Encrypt) account. Used for expiry
# notices; not published.
ACME_EMAIL=admin@example.com

# HTTP Basic Auth for the dashboard + read API served through the proxy. smoked's
# read API has no auth of its own, so the proxy gates it. Remote agents never use
# this or go through this proxy at all — see SMOKED_AGENT_ADDR/SMOKED_AGENT_HOSTNAME
# below. Required when running the federation profile.
#
# Generate the bcrypt hash for your password:
#   docker run --rm caddy:2.11-alpine caddy hash-password --plaintext 'your-password'
#
# Then provide it either way:
#   (a) export it in the shell before `docker compose up`, single-quoted:
#         export DASH_PASSWORD_HASH='$2a$14$....'
#   (b) or paste it below, single-quoted — the single quotes stop Compose from interpolating the
#       '$', so keep the hash EXACTLY as generated (do NOT double the '$' to '$$'), e.g.
#       DASH_PASSWORD_HASH='$2a$14$....'
DASH_USER=admin
DASH_PASSWORD_HASH=

# --- Collector settings (SMOKED_*): read by the DEFAULT `docker compose up`, no
#     profile needed. These configure smoked itself, not the Caddy proxy. ---

# Opt-in mutual-TLS federation agent listener — smoked's own dedicated HTTPS server
# for remote `smoke-agent` vantages, entirely separate from the dashboard above and
# NOT proxied by Caddy. Leave both empty (the default) for a single-host deployment
# with no agent listener at all. To enable it, set:
#   SMOKED_AGENT_ADDR=:8443
#   SMOKED_AGENT_HOSTNAME=your-domain.example.com   # typically the same as DOMAIN
# smoked self-bootstraps a CA and issues its own server certificate (SAN from
# SMOKED_AGENT_HOSTNAME); each vantage authenticates with a CA-signed client
# certificate — there's no API key to manage. Requires SMOKED_DSN (already set
# below); smoked fatals at startup if SMOKED_AGENT_ADDR is set without a DSN. See
# docs/federation.md.
SMOKED_AGENT_ADDR=
SMOKED_AGENT_HOSTNAME=

# Optional: enable the password-gated admin vantage-management API + the Vantages
# GUI panel (onboard/list/revoke vantages — onboarding downloads a ready-to-run
# mTLS cert bundle). Leave empty to keep it disabled (fail-closed); provision
# vantages with the `smoked vantage` CLI instead. When set, the panel is reachable
# through the proxy (behind the Basic Auth above, then its own admin password) or
# on http://localhost:8087/ on the hub.
SMOKED_ADMIN_PASSWORD=
# Independent cookie-signing key: exactly 32 random bytes encoded as 64 hex
# characters. Keep it stable to preserve admin sessions across collector restarts;
# rotating it logs every session out (rotate it with the password when revoking access).
# Generate once with: openssl rand -hex 32
# If omitted, smoked safely generates an ephemeral key and sessions end on restart.
SMOKED_ADMIN_SESSION_KEY=
# How long an admin login stays valid (token expiry + cookie Max-Age). Any Go
# duration, e.g. 24h / 168h / 30m (minimum 1m). Empty uses the 12h default.
SMOKED_ADMIN_SESSION_TTL=
# Graph x-axis labels: 1 (default) = absolute clock time; 0 = relative (-3h / now).
SMOKED_ABSOLUTE_TIME=

# --- TLS certificate challenge (optional) ---
# By default Caddy uses the HTTP-01 challenge (needs inbound port 80 during
# issuance/renewal). To use DNS-01 instead — no inbound 80/443 needed for
# validation, works behind NAT, supports wildcards — set CADDY_ACME_DNS to your
# provider's `acme_dns` line and supply its credential var(s). The bundled image
# includes: cloudflare, route53, digitalocean, duckdns, namecheap, gandi.
#
# Single-token providers — one line does it:
#   Cloudflare (token with Zone:DNS:Edit):
#     CADDY_ACME_DNS=acme_dns cloudflare {env.CF_API_TOKEN}
#     CF_API_TOKEN=your-cloudflare-token
#   DigitalOcean (scoped API token):
#     CADDY_ACME_DNS=acme_dns digitalocean {env.DO_AUTH_TOKEN}
#     DO_AUTH_TOKEN=your-do-token
#   DuckDNS:
#     CADDY_ACME_DNS=acme_dns duckdns {env.DUCKDNS_API_TOKEN}
#     DUCKDNS_API_TOKEN=your-duckdns-token
#   Gandi (Personal Access Token; the old API key is unsupported):
#     CADDY_ACME_DNS=acme_dns gandi {env.GANDI_BEARER_TOKEN}
#     GANDI_BEARER_TOKEN=your-gandi-pat
#
# Multi-field providers — set the credential vars below AND add the matching
# block to the Caddyfile's global options (a single CADDY_ACME_DNS line can't
# hold a nested block cleanly):
#   Namecheap — set NAMECHEAP_API_KEY + NAMECHEAP_API_USER, then in Caddyfile:
#     acme_dns namecheap {
#       api_key {env.NAMECHEAP_API_KEY}
#       user {env.NAMECHEAP_API_USER}
#     }
#   Route53 — set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + AWS_REGION, then:
#     acme_dns route53 {
#       region {env.AWS_REGION}
#     }
CADDY_ACME_DNS=
CF_API_TOKEN=
DO_AUTH_TOKEN=
DUCKDNS_API_TOKEN=
GANDI_BEARER_TOKEN=
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
