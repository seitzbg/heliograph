# Environment for the federation stack. Copy to .env and fill in:
#
#   cp .env.example .env
#
# The proxy settings (DOMAIN, ACME_EMAIL, DASH_PASSWORD_HASH) are REQUIRED — Caddy
# needs them to obtain a certificate and gate the dashboard. The rest are optional.

# --- Reverse proxy / TLS (required) ---

# Public hostname browsers reach the dashboard at (via Caddy on :443) and agents reach the
# mTLS listener at (smoked's own :8443, published directly — not proxied). Also used as the
# SAN on smoked's self-issued agent-API server certificate (-agent-hostname). Its DNS A/AAAA
# record must point at this host, and (for the default HTTP-01 challenge) port 80 must be
# reachable from the internet during issuance/renewal. Tip: DOMAIN=localhost serves a
# self-signed cert for a local smoke test (Caddy skips ACME for localhost).
DOMAIN=smoke.example.com

# Contact address for the ACME (Let's Encrypt) account. Used for expiry notices; not published.
ACME_EMAIL=admin@example.com

# HTTP Basic Auth for the dashboard + read API served through the proxy. Remote agents don't
# use this at all — they connect straight to smoked's own mTLS listener on :8443 (published by
# docker-compose.yml) and authenticate with a CA-signed client certificate from their onboarding
# bundle. There is no key or env secret to configure on the agent side beyond the mounted
# agent.yaml; see docs/federation.md.
#   Generate the bcrypt hash:
#     docker run --rm caddy:2.11-alpine caddy hash-password --plaintext 'your-password'
#   Then provide it either way:
#     (a) safest — export it in the shell before `docker compose up`, single-quoted:
#           export DASH_PASSWORD_HASH='$2a$14$....'
#     (b) or paste below with every '$' DOUBLED to '$$' (Compose interpolates '$' in this file):
#           DASH_PASSWORD_HASH='$$2a$$14$$....'
DASH_USER=admin
DASH_PASSWORD_HASH=

# --- Collector (SMOKED_*) ---

# Enable the admin GUI so you can onboard/list/revoke vantages (the Vantages tab, which downloads
# a ready-to-run cert bundle for each new vantage) and edit DB targets. Practically required for
# federation unless you provision vantages with the `smoked vantage` CLI. Reached through the
# proxy (behind the Basic Auth above, then its own admin password).
SMOKED_ADMIN_PASSWORD=

# Cookie-signing key: 32 random bytes as 64 hex chars — keep it stable so admin sessions survive
# collector restarts. Generate once with:  openssl rand -hex 32
SMOKED_ADMIN_SESSION_KEY=

# How long an admin login stays valid. Any Go duration (e.g. 24h / 168h / 30m, min 1m). Empty = 12h.
SMOKED_ADMIN_SESSION_TTL=

# Graph x-axis labels: 1 (default) = absolute clock time; 0 = relative (-3h / now).
SMOKED_ABSOLUTE_TIME=1

# Database password, applied to both the DB and the collector's DSN. Written to the tsdata volume
# on first init (see the standalone .env.example note about rotating it).
SMOKE_DB_PASSWORD=smoke
