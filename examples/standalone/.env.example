# Environment for the standalone (non-federation) stack. Copy to .env and edit:
#
#   cp .env.example .env
#
# Everything here is optional — `docker compose up -d` works with no .env at all
# (default DB password, demo targets, admin GUI disabled). Set values to change that.

# Database password, applied to BOTH the DB and the collector's DSN at once. NOTE: it is
# written into the tsdata volume on first init, so changing it later does not re-initialize
# an existing volume — recreate the volume (or ALTER ROLE inside the DB) to rotate it.
SMOKE_DB_PASSWORD=smoke

# Graph x-axis labels: 1 (default) = absolute clock time; 0 = relative (-3h / now).
SMOKED_ABSOLUTE_TIME=1

# --- Optional admin GUI (Config + Vantages tabs) ---
# Enable the password-gated admin API + GUI. Leave empty to keep it disabled (fail-closed).
# With it set, you can edit database-backed targets from the browser. (Vantage key management
# only matters for federation — see ../federation.)
SMOKED_ADMIN_PASSWORD=

# Cookie-signing key: exactly 32 random bytes as 64 hex chars. Keep it stable so admin sessions
# survive collector restarts. Generate once with:  openssl rand -hex 32
# If omitted, smoked uses a fresh ephemeral key and sessions end on every restart.
SMOKED_ADMIN_SESSION_KEY=

# How long an admin login stays valid (token expiry + cookie Max-Age). Any Go duration,
# e.g. 24h / 168h / 30m (minimum 1m). Empty uses the 12h default.
SMOKED_ADMIN_SESSION_TTL=
