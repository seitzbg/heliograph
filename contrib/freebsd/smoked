#!/bin/sh
#
# PROVIDE: smoked
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# FreeBSD rc.d script for the Heliograph hub (smoked) run natively — the dashboard,
# JSON/admin API, and (optionally) the mTLS federation agent API. Needs a reachable
# PostgreSQL/TimescaleDB. Install to /usr/local/etc/rc.d/smoked and enable in
# /etc/rc.conf:
#
#   smoked_enable="YES"
#   smoked_dsn="postgres://smoke:smoke@db.example:5432/smoke?sslmode=disable"
#
# Optional overrides (defaults shown):
#   smoked_bin="/usr/local/bin/smoked"
#   smoked_user="smoke"                                  # service account (created separately)
#   smoked_addr=":8087"                                  # dashboard + read/admin API listen address
#   smoked_webdir="/usr/local/share/heliograph/web"      # static web assets (from the release tarball)
#   smoked_config=""                                     # path to a YAML config file/dir; "" = built-in demo targets
#   smoked_flags="-downsample"                           # extra flags (e.g. -agent-addr :8443 -agent-hostname host)
#
# The dashboard/API is UNAUTHENTICATED — bind loopback (smoked_addr="127.0.0.1:8087") or
# front it with a TLS + Basic-Auth reverse proxy. See the README's Federation section.

. /etc/rc.subr

name="smoked"
desc="Heliograph hub"
rcvar="smoked_enable"

load_rc_config "$name"

: ${smoked_enable:="NO"}
: ${smoked_bin:="/usr/local/bin/smoked"}
: ${smoked_user:="smoke"}
: ${smoked_addr:=":8087"}
: ${smoked_webdir:="/usr/local/share/heliograph/web"}
: ${smoked_config:=""}
: ${smoked_dsn:=""}
: ${smoked_flags:="-downsample"}

pidfile="/var/run/${name}.pid"

# Assemble the child command. -serve runs the daemon forever.
_child_args="-serve -addr ${smoked_addr} -webdir ${smoked_webdir}"
if [ -n "${smoked_dsn}" ]; then
	_child_args="${_child_args} -dsn ${smoked_dsn}"
fi
if [ -n "${smoked_config}" ]; then
	_child_args="${_child_args} -config ${smoked_config}"
fi
_child_args="${_child_args} ${smoked_flags}"

# Supervise with daemon(8): -r restarts on exit, -S routes output to syslog,
# -P tracks the supervisor pid, -u drops to the service user.
command="/usr/sbin/daemon"
command_args="-r -S -P ${pidfile} -t ${desc} -u ${smoked_user} ${smoked_bin} ${_child_args}"

run_rc_command "$1"
