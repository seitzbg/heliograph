# Bundled reverse proxy for Heliograph federation — fronts the DASHBOARD ONLY.
#
#   docker compose --profile federation up
#
# Caddy terminates TLS with an automatically issued (and auto-renewed) Let's
# Encrypt certificate for $DOMAIN, and gates the dashboard/read/admin API/
# /metrics behind HTTP Basic Auth (smoked's read API has no auth of its own).
# Set DASH_USER + DASH_PASSWORD_HASH (see .env.example).
#
# Remote agents do NOT go through Caddy: they connect straight to smoked's own
# mutual-TLS listener on :8443 (see docker-compose.yml's `smoked` service) and
# authenticate with a CA-signed client certificate — no API key, no Basic Auth,
# no Caddy in the path at all. See docs/federation.md.
#
# Set DOMAIN and ACME_EMAIL in .env. For a local smoke test without hitting
# Let's Encrypt, set DOMAIN=localhost — Caddy then serves an internal
# (self-signed) cert automatically instead of attempting ACME.
{
	# ACME account contact. Caddy issues/renews the cert automatically.
	email {$ACME_EMAIL}
	# TLS challenge. Empty (default) = HTTP-01 (needs inbound port 80). To use
	# DNS-01 instead (works behind NAT, no inbound 80/443 for validation), set
	# CADDY_ACME_DNS in .env, e.g. `acme_dns cloudflare {env.CF_API_TOKEN}` — the
	# image must be built with the matching caddy-dns plugin (see Caddy.Dockerfile).
	{$CADDY_ACME_DNS}
}

{$DOMAIN} {
	# Dashboard + read/query API + admin panel: gated by HTTP Basic Auth, since
	# smoked's read API is otherwise unauthenticated. Served over the proxy's TLS.
	basic_auth {
		{$DASH_USER} {$DASH_PASSWORD_HASH}
	}
	reverse_proxy smoked:8087
}
